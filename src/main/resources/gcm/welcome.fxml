<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Welcome screen, shown after a successful login -->

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="650.0" spacing="10.0" style="-fx-background-color: #e8f4ea;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gcm.WelcomeController">
   <padding>
      <Insets left="20.0" right="20.0" />
   </padding>
   <children>
      <Label fx:id="welcomeLabel" text="Welcome!" textAlignment="CENTER" textFill="#3ec0d6" wrapText="true">
         <font>
            <Font name="System Bold" size="34.0" />
         </font>
      </Label>
      <Label text="You are logged in to the GCM system.">
         <font>
            <Font size="16.0" />
         </font></Label>
   </children>
</VBox>
